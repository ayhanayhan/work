{
  "name": "commerce-saas-firebase-test",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @commerce/api run start:dev",
    "dev:admin": "npm --workspace @commerce/admin run dev",
    "dev:storefront": "npm --workspace @commerce/storefront run dev",
    "dev:superadmin": "npm --workspace @commerce/superadmin run dev",
    "prisma:generate": "npm --workspace @commerce/api run prisma:generate",
    "prisma:migrate": "npm --workspace @commerce/api run prisma:migrate",
    "prisma:seed": "npm --workspace @commerce/api run prisma:seed",
    "build": "npm -ws run build --if-present",
    "smoke": "node scripts/smoke-test.mjs",
    "prisma:push": "npm --workspace @commerce/api run prisma:push",
    "dev:developer": "npm --workspace @commerce/developer run dev",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:i18n:strict": "I18N_STRICT=1 node scripts/audit-i18n.mjs",
    "audit:i18n:deep": "node scripts/audit-i18n-deep.cjs",
    "verify:module-platform": "node scripts/module-platform-final-check.mjs",
    "e2e:module-platform": "node scripts/module-platform-e2e.mjs",
    "verify:stabilization": "node scripts/stabilization-check.mjs",
    "verify:scale": "node scripts/scale-foundation-check.mjs",
    "loadtest:scale": "node scripts/load-test-scale.mjs",
    "verify:shopify-readiness": "node scripts/shopify-readiness-v29-check.mjs",
    "audit:production-security": "node scripts/security-audit-v29_8.mjs",
    "verify:e2e-commerce": "node scripts/e2e-commerce-v29_2-check.mjs",
    "verify:dependency-security": "node scripts/dependency-security-v29_5-check.mjs",
    "verify:moderate-security": "node scripts/moderate-security-v29_6-check.mjs",
    "verify:transitive-security": "node scripts/transitive-security-v29_8-check.mjs",
    "security:refresh-transitives": "node scripts/refresh-transitive-security-v29_8.mjs",
    "verify:production-migrations": "node scripts/production-migration-v30-check.mjs",
    "verify:api-image": "node scripts/api-image-v30_1-check.mjs",
    "verify:production-concurrency": "node scripts/production-concurrency-v30_2-check.mjs",
    "verify:payment-webhooks": "node scripts/payment-webhook-v30_3-check.mjs",
    "verify:tenant-isolation": "node scripts/tenant-isolation-v30_4-check.mjs",
    "verify:shipping-rates": "node scripts/shipping-rates-v30_5-check.mjs",
    "verify:b2b-credit": "node scripts/b2b-credit-v30_6-check.mjs",
    "verify:exchange-completion": "node scripts/exchange-completion-v30_7-check.mjs",
    "verify:production-e2e": "node scripts/production-e2e-v30_8.mjs",
    "verify:critical-security-refresh": "node scripts/critical-security-v30_8_2-check.mjs",
    "verify:production-deploy": "node scripts/production-deploy-v30_9-check.mjs",
    "test:p0:unit": "npm --workspace @commerce/api run test:unit",
    "test:p0:integration": "node scripts/p0-integration-concurrency.mjs",
    "verify:p0": "npm run test:p0:unit && npm run verify:production-concurrency && npm run verify:tenant-isolation && npm run verify:payment-webhooks",
    "verify:p1": "node scripts/p1-platform-hardening-check.mjs && npm run verify:p0",
    "verify:p2": "node scripts/p2-production-operations-check.mjs && node scripts/p1-platform-hardening-check.mjs",
    "test:core-integration": "node scripts/core-commerce-integration.mjs",
    "loadtest:checkout5000": "node scripts/load-test-checkout-5000.mjs",
    "verify:core-v33": "npm run verify:p1 && npm run verify:production-migrations && npm --workspace @commerce/api run test:unit",
    "verify:v33-core": "node scripts/core-v33-priorities-check.mjs",
    "dev:help": "npm --workspace @commerce/help run dev",
    "dev:master": "npm --workspace @commerce/master run dev",
    "dev:marketing": "npm --workspace @commerce/marketing run dev",
    "check:marketing": "npm --workspace @commerce/marketing run check",
    "build:developer": "npm --workspace @commerce/developer run build"
  },
  "overrides": {
    "multer": "2.4.0",
    "gaxios": {
      "uuid": "$uuid"
    },
    "postman-request": {
      "uuid": "$uuid",
      "qs": "6.16.0"
    },
    "seroval": "1.6.8",
    "source-map-js": "$source-map-js"
  },
  "dependencies": {
    "source-map-js": "1.2.2",
    "uuid": "11.1.1"
  }
}
