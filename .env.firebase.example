# API / Cloud Run
DATABASE_URL=postgresql://commerce:PASSWORD@HOST:5432/commerce?schema=public&sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
JWT_SECRET=generate-at-least-64-random-characters
INTEGRATION_ENCRYPTION_KEY=generate-a-different-64-random-character-secret
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/api/v1/auth
CUSTOMER_AUTH_COOKIE_PATH=/api/v1/storefront/customer
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
PUBLIC_API_URL=https://REPLACE_WITH_CLOUD_RUN_API_URL
GCS_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
WEBHOOK_ALLOW_PRIVATE=false
NODE_ENV=production
TEST_DB_BOOTSTRAP=true
TEST_DB_SEED=true
SEED_OWNER_PASSWORD=replace-with-strong-test-password
SEED_SUPERADMIN_PASSWORD=replace-with-another-strong-test-password

# Next.js apps use a same-origin proxy to Cloud Run.
API_ORIGIN=https://REPLACE_WITH_CLOUD_RUN_API_URL
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_STORE_SLUG=main
