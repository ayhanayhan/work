FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV TICARTI_V30_9_1_ROOT_LOCK_INSTALL=1

# Reproducible workspace install: root lockfile + root overrides are authoritative.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/developer/package.json apps/developer/package.json
COPY apps/storefront/package.json apps/storefront/package.json
COPY apps/superadmin/package.json apps/superadmin/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY scripts/api-runtime-deps-v30_9_5-check.cjs scripts/api-runtime-deps-v30_9_5-check.cjs

RUN npm ci --no-audit --no-fund \
 && node scripts/api-runtime-deps-v30_9_5-check.cjs

COPY apps/api/prisma apps/api/prisma
RUN npm --workspace @commerce/api run prisma:generate

COPY apps/api/nest-cli.json apps/api/tsconfig.json apps/api/
COPY apps/api/src apps/api/src
RUN npm --workspace @commerce/api run build \
 && test -f apps/api/dist/main.js

COPY modules/payment-stripe/transport.cjs /app/modules/payment-stripe/transport.cjs
ENV TICARTI_MODULES_DIR=/app/modules
COPY apps/api/docker-entrypoint.sh apps/api/db-init.sh apps/api/
RUN chmod +x apps/api/docker-entrypoint.sh apps/api/db-init.sh

WORKDIR /app/apps/api
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
CMD ["./docker-entrypoint.sh"]
