  fields      Json
  access      Json?
  store       Tenant            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entries     MetaobjectEntry[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([storeId, type])
}

model MetaobjectEntry {
  id           String               @id @default(uuid())
  definitionId String
  handle       String
  fields       Json
  status       String               @default("ACTIVE")
  definition   MetaobjectDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([definitionId, handle])
  @@index([definitionId, status])
}

model SalesChannel {
  id             String                       @id @default(uuid())
  storeId        String
  key            String
  name           String
  type           String
  active         Boolean                      @default(true)
  isSystem       Boolean                      @default(false)
  priceListId    String?
  config         Json?
  store          Tenant                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  priceList      PriceList?                    @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  stockLocations SalesChannelStockLocation[]
  products       ProductSalesChannel[]
  publications   ChannelPublication[]
  orders         Order[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([storeId, key])
  @@unique([storeId, type, name])
  @@index([storeId, active])
  @@index([priceListId])
}


model ProductSalesChannel {
  id             String       @id @default(uuid())
  productId      String
  salesChannelId String
  published      Boolean      @default(true)
  externalId     String?
  metadata       Json?
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([productId, salesChannelId])
  @@index([salesChannelId, published])
  @@index([productId, published])
}

model SalesChannelStockLocation {
  id             String       @id @default(uuid())
  salesChannelId String
  warehouseId    String
  priority       Int          @default(100)
  active         Boolean      @default(true)
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([salesChannelId, warehouseId])
  @@index([warehouseId, active, priority])
}

model ChannelPublication {
  id           String       @id @default(uuid())
  channelId    String
  resourceType String
  resourceId   String
  status       String       @default("PUBLISHED")
  externalId   String?
  metadata     Json?
  channel      SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  publishedAt  DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([channelId, resourceType, resourceId])
  @@index([resourceType, resourceId])
}


model EmailSesConfiguration {
  id String @id @default("default")
  txRegion String @default("eu-central-1")
  txConfigurationSet String?
  txSnsTopicArn String?
  mktRegion String?
  mktConfigurationSet String?
  mktSnsTopicArn String?
  updatedAt DateTime @updatedAt
}
