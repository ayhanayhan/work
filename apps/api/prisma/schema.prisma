  store       Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, visitorId])
}

model AuditLog {
  id            String      @id @default(uuid())
  tenantId      String?
  userId        String?
  superAdminId  String?
  action        String
  resource      String
  resourceId    String?
  method        String
  path          String
  statusCode    Int
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  superAdmin    SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([superAdminId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  kind      String
  emailHash String?
  ipHash    String?
  success   Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([kind, emailHash, createdAt])
  @@index([kind, ipHash, createdAt])
}

model Question {
  id               String         @id @default(uuid())
  storeId          String
  type             QuestionType
  status           QuestionStatus @default(NEW)
  productId        String?
  orderId          String?
  customerId       String?
  email            String?
  subject          String?
  question         String
  answer           String?
  internalNote     String?
  assignedUserId   String?
  priority         String         @default("NORMAL")
  publishOnProduct Boolean        @default(false)
  answeredAt       DateTime?
  closedAt         DateTime?
  store            Tenant         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([storeId, type, status, createdAt])
  @@index([productId])
  @@index([orderId])
  @@index([customerId])
}

model GeoNode {
  id          String        @id @default(uuid())
  key         String        @unique
  parentId    String?
  level       GeoLevel
  countryCode String
  code        String?
  name        String
  slug        String
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  metadata    Json?
  parent      GeoNode?      @relation("GeoTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    GeoNode[]     @relation("GeoTree")
  overrides   GeoOverride[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([countryCode, level, parentId, isActive])
}

model GeoOverride {
  id         String   @id @default(uuid())
  tenantId   String
  geoNodeId  String
  customName String?
  isEnabled  Boolean  @default(true)
  geoNode    GeoNode  @relation(fields: [geoNodeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, geoNodeId])
  @@index([tenantId, isEnabled])
}

model GeoCustomNode {
  id          String   @id @default(uuid())
  tenantId    String
  parentId    String?
  level       GeoLevel
  countryCode String
  code        String?
  name        String
  slug        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, countryCode, level, parentId, isActive])
}

model SeoRule {
  id                  String   @id @default(uuid())
  storeId             String
  targetType          String
  locale              String?
  titleTemplate       String?
  descriptionTemplate String?
  slugTemplate        String?
  canonicalTemplate   String?
  conditions          Json?
  priority            Int      @default(100)
  enabled             Boolean  @default(true)
  store               Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([storeId, targetType, enabled])
}

model SeoRedirect {
  id         String   @id @default(uuid())
  storeId    String
  fromPath   String
  toPath     String
  statusCode Int      @default(301)
  hits       Int      @default(0)
  enabled    Boolean  @default(true)
  store      Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([storeId, fromPath])
}

model SiteSection {
  id          String   @id @default(uuid())
  storeId     String
  pageKey     String   @default("home")
  sectionType String
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  settings    Json
  store       Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId, pageKey, sortOrder])
}

model CacheConfig {
  id                   String   @id @default(uuid())
  storeId              String   @unique
  enabled              Boolean  @default(true)
  appTtlSeconds        Int      @default(300)
  storefrontTtlSeconds Int      @default(120)
  seoTtlSeconds        Int      @default(900)
  menuTtlSeconds       Int      @default(900)
  warmHome             Boolean  @default(true)
  warmCategories       Boolean  @default(true)
  settings             Json?
  store                Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CheckoutConfig {
  id                    String             @id @default(uuid())
  storeId               String             @unique
  singlePage            Boolean            @default(true)
  customerAccessMode    CheckoutAccessMode @default(GUEST)
  allowGuestCheckout    Boolean            @default(true)
  requirePhone          Boolean            @default(true)
  requireBillingAddress Boolean            @default(false)
  showCouponField       Boolean            @default(true)
  stickyOrderSummary    Boolean            @default(true)
  requireTerms          Boolean            @default(true)
  requirePrivacyNotice  Boolean            @default(true)
  requireKvkkNotice     Boolean            @default(false)
  settings              Json?
  store                 Tenant             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model AiCreditPackage {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  credits   Int
  price     Decimal  @db.Decimal(12, 2)
  currency  String   @default("TRY")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiCreditWallet {
  id                String           @id @default(uuid())
  tenantId          String           @unique
  balance           Int              @default(0)
  lifetimePurchased Int              @default(0)
  lifetimeUsed      Int              @default(0)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledger            AiCreditLedger[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model AiCreditLedger {
  id           String         @id @default(uuid())
  walletId     String
  amount       Int
  type         String
  source       String?
  referenceId  String?
  description  String?
  balanceAfter Int
  metadata     Json?
  wallet       AiCreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@index([walletId, createdAt])
}

model Warehouse {
  id        String           @id @default(uuid())
  storeId   String
  name      String
  code      String
  isDefault Boolean          @default(false)
  isActive  Boolean          @default(true)
  priority  Int              @default(100)
  address   Json?
  store     Tenant           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stocks    WarehouseStock[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([storeId, code])
  @@index([storeId, isActive, priority])
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  variantId   String
  onHand      Int       @default(0)
  reserved    Int       @default(0)
  safetyStock Int       @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model SeoTranslation {
  id             String   @id @default(uuid())
  storeId        String
  resourceType   String
  resourceId     String
  locale         String
  slug           String?
  seoTitle       String?
  seoDescription String?
  hreflang       String?
  canonicalUrl   String?
  store          Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, resourceType, resourceId, locale])
  @@index([storeId, locale])
}

model SeoInternalLink {
  id         String   @id @default(uuid())
  storeId    String
  keyword    String
  targetUrl  String
  locale     String?
  maxPerPage Int      @default(1)
  noFollow   Boolean  @default(false)
  enabled    Boolean  @default(true)
  store      Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId, enabled])
}

model SeoAudit {
  id           String    @id @default(uuid())
  storeId      String
  kind         String
  severity     String
  resourceType String?
  resourceId   String?
  url          String?
  message      String
  details      Json?
  resolvedAt   DateTime?
  store        Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([storeId, severity, createdAt])
}

model ReservedSubdomain {
  id        String   @id @default(uuid())
  value     String   @unique
  reason    String?
  isActive  Boolean  @default(true)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, value])
}


model CheckoutSession {
  id             String   @id @default(uuid())
  storeId        String
  cartId         String
  customerId     String?
  orderId        String?
  status         String   @default("OPEN")
  locale         String?
  currency       String?
  storeOrigin    String
  checkoutOrigin String
  returnUrl      String?
  expiresAt      DateTime
  completedAt    DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([storeId, status, expiresAt])
  @@index([cartId, status])
  @@index([orderId])
}
