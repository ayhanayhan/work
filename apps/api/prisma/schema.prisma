generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountScope {
  ORDER
  PRODUCT
  CATEGORY
}

enum IntegrationType {
  MARKETPLACE
  PAYMENT
  SHIPPING
  INVOICE
  MARKETING
  AI
  SOCIAL
  ANALYTICS
  MESSAGING
  CRM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogCommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum QuestionType {
  PRODUCT
  ORDER
}

enum QuestionStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  SPAM
}

enum GeoLevel {
  COUNTRY
  ADMIN1
  ADMIN2
  LOCALITY
  NEIGHBORHOOD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AppInstallStatus {
  INSTALLING
  ACTIVE
  DISABLED
  ERROR
}

enum AppGrantSource {
  STORE
  SUPERADMIN
  PLAN
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum CheckoutAccessMode {
  REQUIRED
  SUGGESTED
  GUEST
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum PromotionActivation {
  AUTOMATIC
  COUPON
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MarketingChannel {
  EMAIL
  SMS
  POPUP
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum AutomationTrigger {
  CART_ABANDONED
  CHECKOUT_ABANDONED
  PAYMENT_FAILED
  CUSTOMER_CREATED
  ORDER_CREATED
  ORDER_PAID
  CUSTOMER_BIRTHDAY
  MANUAL
}

enum ConsentType {
  TERMS
  PRIVACY
  KVKK_NOTICE
  KVKK_EXPLICIT_CONSENT
  MARKETING_EMAIL
  MARKETING_SMS
  MARKETING_PHONE
  COOKIES_NECESSARY
  COOKIES_ANALYTICS
  COOKIES_MARKETING
}

enum PrivacyRequestType {
  ACCESS
  DELETE
  RECTIFY
  PORTABILITY
  RESTRICT
  OBJECT
}

enum PrivacyRequestStatus {
  RECEIVED
  VERIFYING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  KVKK_NOTICE
  COOKIE_POLICY
  DISTANCE_SALES
  RETURNS
  SHIPPING
}

model User {
  id               String                  @id @default(uuid())
  email            String                  @unique
  passwordHash     String?
  googleSub        String?                 @unique
  emailVerifiedAt  DateTime?
  name             String?
  isSuperAdmin     Boolean                 @default(false) // legacy migration-only; runtime auth does not read this
  memberships      Membership[]
  ticketMessages   SupportMessage[]
  sessions         UserSession[] // legacy, no longer used by admin auth
  merchantSessions MerchantSession[]
  passwordResets   MerchantPasswordReset[]
  authHandoffs     MerchantAuthHandoff[]
  auditLogs        AuditLog[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model Tenant {
  id                       String                  @id @default(uuid())
  name                     String
  slug                     String                  @unique
  status                   TenantStatus            @default(TRIAL)
  trialEndsAt              DateTime?
  memberships              Membership[]
  integrations             IntegrationConnection[]
  webhooks                 WebhookEndpoint[]
  subscriptions            Subscription[]
  tickets                  SupportTicket[]
  roles                    CustomRole[]
  auditLogs                AuditLog[]
  aiWallet                 AiCreditWallet?
  appInstalls              AppInstallation[]
  customerGroups           CustomerGroup[]
  liveVisitors             LiveVisitorSession[]
  apiKeys                  StoreApiKey[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  publicSlug               String                  @unique
  domain                   String?                 @unique
  currency                 String                  @default("TRY")
  locale                   String                  @default("tr-TR")
  timezone                 String                  @default("Europe/Istanbul")
  defaultCountry           String                  @default("TR")
  weightUnit               String                  @default("kg")
  dimensionUnit            String                  @default("cm")
  activeTheme              String                  @default("ticarti-signature-complete")
  logoUrl                  String?
  faviconUrl               String?
  email                    String?
  phone                    String?
  companyName              String?
  taxNumber                String?
  taxOffice                String?
  addressText              String?
  seoTitle                 String?
  seoDescription           String?
  maintenanceMode          Boolean                 @default(false)
  nextOrderNumber          Int                     @default(1001)
  settings                 Json?
  products                 Product[]
  categories               Category[]
  brands                   Brand[]
  customers                Customer[]
  orders                   Order[]
  carts                    Cart[]
  discounts                Discount[]
  shippingMethods          ShippingMethod[]
  paymentMethods           PaymentMethod[]
  pages                    Page[]
  menus                    Menu[]
  banners                  Banner[]
  reviews                  Review[]
  blogCategories           BlogCategory[]
  blogPosts                BlogPost[]
  blogComments             BlogComment[]
  warehouses               Warehouse[]
  questions                Question[]
  wishlists                WishlistItem[]
  returns                  ReturnRequest[]
  addresses                StoreAddress[]
  currencies               StoreCurrency[]
  locales                  StoreLocale[]
  translations             ContentTranslation[]
  mediaAssets              MediaAsset[]
  promotions               Promotion[]
  promotionCodes           PromotionCode[]
  loyaltyProgram           LoyaltyProgram?
  loyaltyAccounts          LoyaltyAccount[]
  marketingCampaigns       MarketingCampaign[]
  marketingAutomations     MarketingAutomation[]
  legalDocuments           LegalDocument[]
  consentRecords           ConsentRecord[]
  privacyRequests          PrivacyRequest[]
  cookiePreferences        CookiePreference[]
  seoRules                 SeoRule[]
  seoRedirects             SeoRedirect[]
  seoTranslations          SeoTranslation[]
  seoInternalLinks         SeoInternalLink[]
  seoAudits                SeoAudit[]
  siteSections             SiteSection[]
  cacheConfig              CacheConfig?
  checkoutConfig           CheckoutConfig?
  planPayments             PlanPayment[]
  themeInstalls            ThemeInstallation[]
  themePayments            ThemePayment[]
  designHistory            ThemeDesignHistory[]
  deletionRequestedAt      DateTime?
  deletionConfirmedAt      DateTime?
  deletionScheduledAt      DateTime?
  deletionRequestTokenHash String?
}

model Membership {
  id           String         @id @default(uuid())
  userId       String
  tenantId     String
  role         MembershipRole @default(STAFF)
  customRoleId String?
  customRole   CustomRole?    @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model Brand {
  id             String    @id @default(uuid())
  storeId        String
  name           String
  slug           String
  logoUrl        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  store          Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, slug])
}

model Category {
  id                 String             @id @default(uuid())
  storeId            String
  parentId           String?
  name               String
  slug               String
  description        String?
  imageUrl           String?
  seoTitle           String?
  seoDescription     String?
  sortOrder          Int                @default(0)
  isActive           Boolean            @default(true)
  store              Tenant             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent             Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]         @relation("CategoryTree")
  products           ProductCategory[]
  discountCategories DiscountCategory[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, parentId])
}

model Product {
  id               String            @id @default(uuid())
  storeId          String
  brandId          String?
  title            String
  slug             String
  description      String?
  shortDescription String?
  status           ProductStatus     @default(DRAFT)
  productType      String?
  tags             String[]          @default([])
  seoTitle         String?
  seoDescription   String?
  metadata         Json?
  store            Tenant            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants         Variant[]
  images           ProductImage[]
  categories       ProductCategory[]
  reviews          Review[]
  blogPosts        BlogPostProduct[]
  wishlists        WishlistItem[]
  discountProducts DiscountProduct[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([brandId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductImage {
  id           String      @id @default(uuid())
  productId    String
  url          String
  alt          String?
  sortOrder    Int         @default(0)
  aiGenerated  Boolean     @default(false)
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variant {
  id              String           @id @default(uuid())
  productId       String
  title           String
  sku             String
  barcode         String?
  price           Decimal          @db.Decimal(12, 2)
  comparePrice    Decimal?         @db.Decimal(12, 2)
  cost            Decimal?         @db.Decimal(12, 2)
  weight          Decimal?         @db.Decimal(10, 3)
  attributes      Json?
  isActive        Boolean          @default(true)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory       InventoryItem?
  warehouseStocks WarehouseStock[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  returnItems     ReturnItem[]

  @@unique([productId, sku])
  @@index([sku])
}

model InventoryItem {
  id             String   @id @default(uuid())
  variantId      String   @unique
  onHand         Int      @default(0)
  reserved       Int      @default(0)
  lowStockAt     Int      @default(5)
  trackStock     Boolean  @default(true)
  allowBackorder Boolean  @default(false)
  variant        Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model Customer {
  id                   String                @id @default(uuid())
  storeId              String
  groupId              String?
  email                String
  passwordHash         String?
  firstName            String?
  lastName             String?
  phone                String?
  acceptsMarketing     Boolean               @default(false)
  isActive             Boolean               @default(true)
  tags                 String[]              @default([])
  metadata             Json?
  store                Tenant                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  group                CustomerGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  addresses            CustomerAddress[]
  orders               Order[]
  reviews              Review[]
  blogComments         BlogComment[]
  wishlists            WishlistItem[]
  returns              ReturnRequest[]
  loyaltyAccount       LoyaltyAccount?
  consentRecords       ConsentRecord[]
  privacyRequests      PrivacyRequest[]
  sessions             CustomerSession[]
  promotionRedemptions PromotionRedemption[]
  carts                Cart[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([storeId, email])
  @@index([storeId, createdAt])
  @@index([storeId, groupId])
}

model CustomerGroup {
  id              String     @id @default(uuid())
  storeId         String
  name            String
  description     String?
  color           String?    @default("#16a34a")
  discountPercent Decimal    @default(0) @db.Decimal(5, 2)
  isDefault       Boolean    @default(false)
  store           Tenant     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customers       Customer[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([storeId, name])
  @@index([storeId, isDefault])
}

model LiveVisitorSession {
  id          String   @id @default(uuid())
  storeId     String
  visitorId   String
  path        String   @default("/")
  state       String   @default("BROWSING")
  city        String?
  country     String?
  cartToken   String?
  customerId  String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  store       Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, visitorId])
  @@index([storeId, lastSeenAt])
  @@index([storeId, state, lastSeenAt])
}

model StoreApiKey {
  id         String    @id @default(uuid())
  storeId    String
  name       String
  prefix     String
  secretHash String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  store      Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([storeId, revokedAt])
}

model CustomerAddress {
  id             String   @id @default(uuid())
  customerId     String
  title          String?
  firstName      String
  lastName       String
  phone          String?
  company        String?
  address1       String
  address2       String?
  district       String?
  city           String
  state          String?
  postalCode     String?
  country        String   @default("TR")
  admin1Id       String?
  admin2Id       String?
  localityId     String?
  neighborhoodId String?
  isDefault      Boolean  @default(false)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Cart {
  id                String     @id @default(uuid())
  storeId           String
  token             String     @unique
  status            String     @default("active")
  customerId        String?
  customerEmail     String?
  discountCode      String?
  couponCodes       String[]   @default([])
  promotionSnapshot Json?
  currency          String?
  lastActivityAt    DateTime   @default(now())
  abandonedAt       DateTime?
  recoveredAt       DateTime?
  note              String?
  shippingMethodId  String?
  paymentMethodId   String?
  billingAddress    Json?
  shippingAddress   Json?
  store             Tenant     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items             CartItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([storeId, status])
}

model CartItem {
  id          String  @id @default(uuid())
  cartId      String
  variantId   String
  quantity    Int     @default(1)
  isGift      Boolean @default(false)
  promotionId String?
  cart        Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     Variant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Discount {
  id               String             @id @default(uuid())
  storeId          String
  name             String
  code             String?
  type             DiscountType
  scope            DiscountScope      @default(ORDER)
  value            Decimal            @default(0) @db.Decimal(12, 2)
  minimumAmount    Decimal?           @db.Decimal(12, 2)
  maximumDiscount  Decimal?           @db.Decimal(12, 2)
  usageLimit       Int?
  usageCount       Int                @default(0)
  perCustomerLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean            @default(true)
  store            Tenant             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products         DiscountProduct[]
  categories       DiscountCategory[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([storeId, code])
  @@index([storeId, isActive])
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}

model DiscountCategory {
  discountId String
  categoryId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
}

model ShippingMethod {
  id               String   @id @default(uuid())
  storeId          String
  name             String
  code             String
  type             String   @default("shipping") // shipping | courier | pickup | digital | appointment
  description      String?
  requiresAddress  Boolean  @default(true)
  supportsPickup   Boolean  @default(false)
  price            Decimal  @default(0) @db.Decimal(12, 2)
  freeAbove        Decimal? @db.Decimal(12, 2)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  store            Tenant   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
}

model PaymentMethod {
  id                    String  @id @default(uuid())
  storeId               String
  name                  String
  code                  String
  type                  String  @default("manual")
  instructions          String?
  requiresOnlinePayment Boolean @default(false)
  supportsInstallment   Boolean @default(false)
  fee                   Decimal @default(0) @db.Decimal(12, 2)
  isActive              Boolean @default(true)
  sortOrder             Int     @default(0)
  config                Json?
  store                 Tenant  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
}

model Order {
  id                   String                @id @default(uuid())
  storeId              String
  customerId           String?
  number               Int
  status               OrderStatus           @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus         @default(PENDING)
  fulfillmentStatus    FulfillmentStatus     @default(UNFULFILLED)
  paymentMethod        String?
  shippingMethod       String?
  currency             String                @default("TRY")
  subtotal             Decimal               @db.Decimal(12, 2)
  discountTotal        Decimal               @default(0) @db.Decimal(12, 2)
  shippingTotal        Decimal               @default(0) @db.Decimal(12, 2)
  paymentFee           Decimal               @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal               @default(0) @db.Decimal(12, 2)
  grandTotal           Decimal               @db.Decimal(12, 2)
  discountCode         String?
  promotionSnapshot    Json?
  customerNote         String?
  adminNote            String?
  shippingAddress      Json?
  billingAddress       Json?
  source               String                @default("storefront")
  externalId           String?
  idempotencyKey       String?
  metadata             Json?
  store                Tenant                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer             Customer?             @relation(fields: [customerId], references: [id])
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  returns              ReturnRequest[]
  promotionRedemptions PromotionRedemption[]
  loyaltyTransactions  LoyaltyTransaction[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([storeId, number])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String       @id @default(uuid())
  orderId     String
  variantId   String?
  sku         String
  title       String
  quantity    Int
  unitPrice   Decimal      @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     Variant?     @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  note      String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id           String       @id @default(uuid())
  storeId      String
  orderId      String
  customerId   String?
  status       ReturnStatus @default(REQUESTED)
  reason       String?
  note         String?
  refundAmount Decimal?     @db.Decimal(12, 2)
  store        Tenant       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  items        ReturnItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([storeId, status])
}

model ReturnItem {
  id            String        @id @default(uuid())
  returnId      String
  orderItemId   String
  variantId     String?
  quantity      Int
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
  variant       Variant?      @relation(fields: [variantId], references: [id])
}

model Review {
  id               String       @id @default(uuid())
  storeId          String
  productId        String
  customerId       String?
  rating           Int
  title            String?
  body             String?
  authorName       String?
  authorEmail      String?
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  media            Json?
  merchantReply    String?
  repliedAt        DateTime?
  spamScore        Decimal?     @db.Decimal(5, 2)
  reportCount      Int          @default(0)
  metadata         Json?
  store            Tenant       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([storeId, status, createdAt])
  @@index([productId, status])
}

model BlogCategory {
  id             String         @id @default(uuid())
  storeId        String
  parentId       String?
  title          String
  slug           String
  description    String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  store          Tenant         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent         BlogCategory?  @relation("BlogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       BlogCategory[] @relation("BlogCategoryTree")
  posts          BlogPost[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, parentId, isActive])
}

model BlogPost {
  id               String            @id @default(uuid())
  storeId          String
  locale           String            @default("tr-TR")
  categoryId       String?
  title            String
  slug             String
  excerpt          String?
  body             String
  featuredImageUrl String?
  status           BlogPostStatus    @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  tags             String[]          @default([])
  publishedAt      DateTime?
  store            Tenant            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category         BlogCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products         BlogPostProduct[]
  comments         BlogComment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status, publishedAt])
  @@index([storeId, locale, status, publishedAt])
