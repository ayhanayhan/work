generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

enum InventoryReservationStatus {
  HELD
  COMMITTED
  RELEASED
  FULFILLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountScope {
  ORDER
  PRODUCT
  CATEGORY
}

enum IntegrationType {
  MARKETPLACE
  PAYMENT
  SHIPPING
  INVOICE
  MARKETING
  AI
  SOCIAL
  ANALYTICS
  MESSAGING
  CRM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogCommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum QuestionType {
  PRODUCT
  ORDER
  B2B_QUOTE
}

enum QuestionStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  SPAM
}

enum CustomerActionTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum StorefrontFilterSourceType {
  BRAND
  PRICE
  AVAILABILITY
  CATEGORY
  PRODUCT_TYPE
  TAG
  OPTION
  METAFIELD
}

enum StorefrontFilterDisplayType {
  CHECKBOX
  RADIO
  SWATCH
  RANGE
}

enum StorefrontFilterSelectionMode {
  AND
  OR
}

enum GeoLevel {
  COUNTRY
  ADMIN1
  ADMIN2
  LOCALITY
  NEIGHBORHOOD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AppInstallStatus {
  INSTALLING
  ACTIVE
  UPDATE_REQUIRED
  DISABLED
  SUSPENDED
  UNINSTALLING
  UNINSTALLED
  ERROR
}

enum AppGrantSource {
  STORE
  SUPERADMIN
  PLAN
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum CheckoutAccessMode {
  REQUIRED
  SUGGESTED
  GUEST
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  EXCHANGED
  CANCELLED
}

enum CollectionMode {
  MANUAL
  AUTOMATED
}

enum PaymentAttemptStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  UNKNOWN
}

enum PaymentTransactionType {
  AUTHORIZE
  CAPTURE
  SALE
  REFUND
  VOID
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PromotionActivation {
  AUTOMATIC
  COUPON
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MarketingChannel {
  EMAIL
  SMS
  WHATSAPP
  POPUP
  PUSH
  AFFILIATE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum AutomationTrigger {
  CART_ABANDONED
  CHECKOUT_ABANDONED
  PAYMENT_FAILED
  CUSTOMER_CREATED
  ORDER_CREATED
  ORDER_PAID
  ORDER_FULFILLED
  CUSTOMER_BIRTHDAY
  CUSTOMER_INACTIVE
  SEGMENT_ENTERED
  STOCK_BACK
  PRODUCT_VIEWED
  MANUAL
}

enum ConsentType {
  TERMS
  PRIVACY
  KVKK_NOTICE
  KVKK_EXPLICIT_CONSENT
  MARKETING_EMAIL
  MARKETING_SMS
  MARKETING_PHONE
  COOKIES_NECESSARY
  COOKIES_ANALYTICS
  COOKIES_MARKETING
}

enum PrivacyRequestType {
  ACCESS
  DELETE
  RECTIFY
  PORTABILITY
  RESTRICT
  OBJECT
}

enum PrivacyRequestStatus {
  RECEIVED
  VERIFYING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  KVKK_NOTICE
  COOKIE_POLICY
  DISTANCE_SALES
  RETURNS
  SHIPPING
}

model User {
  id               String                  @id @default(uuid())
  email            String                  @unique
  passwordHash     String?
  googleSub        String?                 @unique
  emailVerifiedAt  DateTime?
  name             String?
  isSuperAdmin     Boolean                 @default(false) // legacy migration-only; runtime auth does not read this
  memberships      Membership[]
  ticketMessages   SupportMessage[]
  sessions         UserSession[] // legacy, no longer used by admin auth
  merchantSessions MerchantSession[]
  passwordResets   MerchantPasswordReset[]
  authHandoffs     MerchantAuthHandoff[]
  auditLogs        AuditLog[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

enum InfrastructureCellStatus {
  ACTIVE
  DRAINING
  READ_ONLY
  DISABLED
}

enum TenantWorkloadClass {
  STANDARD
  BUSY
  HIGH_VOLUME
  DEDICATED
}

enum TenantIsolationLevel {
  SHARED
  ISOLATED_WORKERS
  DEDICATED_CELL
}

enum CellDatabaseMode {
  SHARED
  DEDICATED
}

enum TenantRouteKeyKind {
  MEDIA
  CART
  CUSTOMER_SESSION
}

enum TenantCellMigrationStatus {
  PLANNED
  COPYING
  VERIFYING
  READY_FOR_CUTOVER
  CUTOVER
  COMPLETED
  FAILED
  CANCELLED
}

model InfrastructureCell {
  id              String                   @id @default(uuid())
  code            String                   @unique
  region          String                   @default("europe-west1")
  status          InfrastructureCellStatus @default(ACTIVE)
  databasePoolKey String                   @default("primary")
  databaseMode    CellDatabaseMode         @default(SHARED)
  apiBaseUrl      String?
  redisPoolKey    String                   @default("primary")
  redisNamespace  String                   @default("ticarti")
  queueShardCount Int                      @default(8)
  maxTenants      Int                      @default(5000)
  metadata        Json?
  placements      TenantPlacement[]
  migrationsFrom  TenantCellMigration[]    @relation("TenantCellMigrationSource")
  migrationsTo    TenantCellMigration[]    @relation("TenantCellMigrationTarget")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, region])
  @@index([databasePoolKey, status])
}

model TenantPlacement {
  id                   String               @id @default(uuid())
  tenantId             String               @unique
  cellId               String
  workloadClass        TenantWorkloadClass  @default(STANDARD)
  isolationLevel       TenantIsolationLevel @default(SHARED)
  queueShard           Int?
  maxConcurrentJobs    Int                  @default(2)
  webhookRatePerSecond Int                  @default(20)
  priority             Int                  @default(100)
  version              Int                  @default(1)
  movedAt              DateTime?
  metadata             Json?
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cell                 InfrastructureCell   @relation(fields: [cellId], references: [id], onDelete: Restrict)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([cellId, workloadClass])
  @@index([workloadClass, isolationLevel])
}

model TenantRouteKey {
  id        String             @id @default(uuid())
  kind      TenantRouteKeyKind
  routeKey  String
  tenantId  String
  expiresAt DateTime?
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([kind, routeKey])
  @@index([tenantId, kind])
  @@index([expiresAt])
}

model TenantCellMigration {
  id            String                    @id @default(uuid())
  tenantId      String
  sourceCellId  String
  targetCellId  String
  status        TenantCellMigrationStatus @default(PLANNED)
  sourceVersion Int
  verification  Json?
  error         String?
  startedAt     DateTime?
  verifiedAt    DateTime?
  cutoverAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceCell    InfrastructureCell        @relation("TenantCellMigrationSource", fields: [sourceCellId], references: [id], onDelete: Restrict)
  targetCell    InfrastructureCell        @relation("TenantCellMigrationTarget", fields: [targetCellId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([targetCellId, status])
}

model Tenant {
  id                         String                       @id @default(uuid())
  name                       String
  slug                       String                       @unique
  status                     TenantStatus                 @default(TRIAL)
  trialEndsAt                DateTime?
  memberships                Membership[]
  integrations               IntegrationConnection[]
  webhooks                   WebhookEndpoint[]
  subscriptions              Subscription[]
  tickets                    SupportTicket[]
  roles                      CustomRole[]
  auditLogs                  AuditLog[]
  aiWallet                   AiCreditWallet?
  appInstalls                AppInstallation[]
  appBillingSubscriptions    AppBillingSubscription[]
  appUsageRecords            AppUsageRecord[]
  appBillingCharges          AppBillingCharge[]
  appBillingInvoices         AppBillingInvoice[]
  emailSettings              TenantEmailSettings?
  emailDomains               TenantEmailDomain[]
  emailMarketingPolicy       TenantEmailMarketingPolicy?
  emailCampaigns             EmailCampaign[]
  emailSuppressions          EmailSuppression[]
  emailJobs                  EmailMarketingJob[]
  emailProviderEvents        EmailProviderEvent[]
  emailIysConsents           EmailIysConsent[]
  emailTransactionalMessages EmailTransactionalMessage[]
  customerGroups             CustomerGroup[]
  liveVisitors               LiveVisitorSession[]
  apiKeys                    StoreApiKey[]
  placement                  TenantPlacement?
  cellMigrations             TenantCellMigration[]
  routeKeys                  TenantRouteKey[]
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  publicSlug                 String                       @unique
  domain                     String?                      @unique
  currency                   String                       @default("TRY")
  locale                     String                       @default("tr-TR")
  timezone                   String                       @default("Europe/Istanbul")
  defaultCountry             String                       @default("TR")
  weightUnit                 String                       @default("kg")
  dimensionUnit              String                       @default("cm")
  activeTheme                String                       @default("nova-commerce")
  logoUrl                    String?
  faviconUrl                 String?
  email                      String?
  phone                      String?
  companyName                String?
  taxNumber                  String?
  taxOffice                  String?
  addressText                String?
  seoTitle                   String?
  seoDescription             String?
  maintenanceMode            Boolean                      @default(false)
  nextOrderNumber            Int                          @default(1001)
  settings                   Json?
  products                   Product[]
  categories                 Category[]
  collections                Collection[]
  taxCategories              TaxCategory[]
  suppliers                  Supplier[]
  unitDefinitions            UnitDefinition[]
  personalizationDefinitions PersonalizationDefinition[]
  metafieldDefinitions       MetafieldDefinition[]
  optionPresets              OptionPreset[]
  catalogTags                CatalogTag[]
  sellingPlanGroups          SellingPlanGroup[]
  paymentAttempts            PaymentAttempt[]
  paymentTransactions        PaymentTransaction[]
  fulfillments               Fulfillment[]
  refunds                    Refund[]
  shippingShipments          ShippingShipment[]
  inventoryReservations      InventoryReservation[]
  brands                     Brand[]
  customers                  Customer[]
  orders                     Order[]
  carts                      Cart[]
  discounts                  Discount[]
  shippingMethods            ShippingMethod[]
  paymentMethods             PaymentMethod[]
  pages                      Page[]
  menus                      Menu[]
  banners                    Banner[]
  reviews                    Review[]
  blogCategories             BlogCategory[]
  blogPosts                  BlogPost[]
  blogAuthors                BlogAuthor[]
  blogPostRevisions          BlogPostRevision[]
  blogComments               BlogComment[]
  warehouses                 Warehouse[]
  questions                  Question[]
  wishlists                  WishlistItem[]
  storefrontFilters          StorefrontFilterDefinition[]
  returns                    ReturnRequest[]
  addresses                  StoreAddress[]
  currencies                 StoreCurrency[]
  locales                    StoreLocale[]
  translations               ContentTranslation[]
  mediaAssets                MediaAsset[]
  promotions                 Promotion[]
  promotionCodes             PromotionCode[]
  loyaltyProgram             LoyaltyProgram?
  loyaltyAccounts            LoyaltyAccount[]
  marketingCampaigns         MarketingCampaign[]
  marketingAutomations       MarketingAutomation[]
  marketingSegments          MarketingSegment[]
  marketingDeliveries        MarketingDelivery[]
  marketingAutomationRuns    MarketingAutomationRun[]
  affiliatePartners          AffiliatePartner[]
  affiliateConversions       AffiliateConversion[]
  affiliatePayouts           AffiliatePayout[]
  legalDocuments             LegalDocument[]
  consentRecords             ConsentRecord[]
  privacyRequests            PrivacyRequest[]
  cookiePreferences          CookiePreference[]
  seoRules                   SeoRule[]
  seoRedirects               SeoRedirect[]
  seoTranslations            SeoTranslation[]
  seoInternalLinks           SeoInternalLink[]
  seoAudits                  SeoAudit[]
  seoScans                   SeoScan[]
  seoNotFoundEvents          SeoNotFoundEvent[]
  siteSections               SiteSection[]
  cacheConfig                CacheConfig?
  checkoutConfig             CheckoutConfig?
  planPayments               PlanPayment[]
  themeInstalls              ThemeInstallation[]
  themePayments              ThemePayment[]
  designHistory              ThemeDesignHistory[]
  themeDesignDrafts          ThemeDesignDraft[]
  deletionRequestedAt        DateTime?
  deletionConfirmedAt        DateTime?
  deletionScheduledAt        DateTime?
  deletionRequestTokenHash   String?
  warehouseTransfers         WarehouseTransfer[]
  draftOrders                DraftOrder[]
  giftCards                  GiftCard[]
  storeCreditAccounts        StoreCreditAccount[]
  exchangeRequests           ExchangeRequest[]
  abandonedCheckouts         AbandonedCheckout[]
  fraudRules                 FraudRule[]
  riskAssessments            OrderRiskAssessment[]
  markets                    CommerceMarket[]
  priceLists                 PriceList[]
  b2bCompanies               B2BCompany[]
  purchaseOrders             PurchaseOrder[]
  shippingProfiles           ShippingProfile[]
  metaobjectDefinitions      MetaobjectDefinition[]
  salesChannels              SalesChannel[]
}

// Mail is a separate delivery boundary; existing generic MarketingCampaign rows stay intact.
model EmailPlatformPolicy {
  id                   String   @id @default("default")
  transactionalEnabled Boolean  @default(true)
  marketingEnabled     Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model TenantEmailSettings {
  tenantId       String   @id
  senderMode     String   @default("PLATFORM_DEFAULT")
  senderName     String?
  senderLocal    String   @default("siparis")
  replyTo        String?
  replyVerified  Boolean  @default(false)
  customDomainId String?
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model TenantEmailDomain {
  id            String    @id @default(uuid())
  tenantId      String
  domain        String    @unique
  purpose       String    @default("TRANSACTIONAL")
  status        String    @default("PENDING_DNS")
  txVerified    Boolean   @default(false)
  mktVerified   Boolean   @default(false)
  dmarcStatus   String    @default("UNKNOWN")
  dnsRecords    Json?
  lastCheckedAt DateTime?
  verifiedAt    DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
}

model TenantEmailMarketingPolicy {
  tenantId        String   @id
  enabled         Boolean  @default(false)
  approvalStatus  String   @default("NOT_REQUESTED")
  suspendedReason String?
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt
}

model EmailCampaign {
  id              String              @id @default(uuid())
  tenantId        String
  name            String
  status          String              @default("DRAFT")
  domainId        String?
  subject         String
  preheader       String?
  headline        String
  bodyText        String
  buttonText      String?
  buttonUrl       String?
  senderLocal     String              @default("kampanya")
  attributionCode String?
  audience        Json?
  blocks          Json?
  settings        Json?
  scheduledAt     DateTime?
  sentCount       Int                 @default(0)
  clickCount      Int                 @default(0)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs            EmailMarketingJob[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([tenantId, attributionCode])
  @@index([tenantId, createdAt])
  @@index([status, scheduledAt])
}

model EmailSuppression {
  id        String   @id @default(uuid())
  tenantId  String
  scope     String
  emailHash String
  reason    String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, scope, emailHash])
}

model EmailMarketingJob {
  id             String        @id @default(uuid())
  tenantId       String
  campaignId     String
  customerId     String
  emailHash      String
  status         String        @default("PENDING")
  attempts       Int           @default(0)
  lockedUntil    DateTime?
  nextAttemptAt  DateTime      @default(now())
  providerId     String?
  sentAt         DateTime?
  clickedAt      DateTime?
  billingStatus  String        @default("PENDING")
  creditReserved Boolean       @default(false)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([campaignId, emailHash])
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId, clickedAt])
}

model EmailProviderEvent {
  id         String   @id @default(uuid())
  messageId  String   @unique
  tenantId   String?
  providerId String?
  type       String
  receivedAt DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, receivedAt])
}

model EmailTransactionalMessage {
  id         String   @id @default(uuid())
  tenantId   String?
  emailHash  String
  providerId String   @unique
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model EmailGlobalSuppression {
  emailHash String   @id
  reason    String
  createdAt DateTime @default(now())
}

model EmailIysConsent {
  id         String    @id @default(uuid())
  tenantId   String
  emailHash  String
  status     String    @default("UNKNOWN")
  receiptRef String?
  source     String?
  checkedAt  DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, emailHash])
  @@index([tenantId, status])
}

model Membership {
  id                   String                @id @default(uuid())
  userId               String                @unique
  tenantId             String
  role                 MembershipRole        @default(STAFF)
  customRoleId         String?
  customRole           CustomRole?           @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseAssignments MembershipWarehouse[]

  @@unique([userId, tenantId])
}

model MembershipWarehouse {
  id                String     @id @default(uuid())
  membershipId      String
  warehouseId       String
  isPrimary         Boolean    @default(false)
  canManageStock    Boolean    @default(true)
  canFulfillOrders  Boolean    @default(true)
  canTransfer       Boolean    @default(true)
  canReceiveReturns Boolean    @default(true)
  membership        Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  warehouse         Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([membershipId, warehouseId])
  @@index([warehouseId, canManageStock])
  @@index([warehouseId, canFulfillOrders])
}

model Brand {
  id             String    @id @default(uuid())
  storeId        String
  name           String
  slug           String
  logoUrl        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  store          Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, slug])
}

model Category {
  id                    String             @id @default(uuid())
  storeId               String
  parentId              String?
  name                  String
  slug                  String
  description           String?
  imageUrl              String?
  seoTitle              String?
  seoDescription        String?
  sortOrder             Int                @default(0)
  isActive              Boolean            @default(true)
  store                 Tenant             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent                Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children              Category[]         @relation("CategoryTree")
  products              ProductCategory[]
  discountCategories    DiscountCategory[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  googleProductCategory String?

  @@unique([storeId, slug])
  @@index([storeId, parentId])
}

model Product {
  id                    String                   @id @default(uuid())
  storeId               String
  brandId               String?
  taxCategoryId         String?
  unitDefinitionId      String?
  title                 String
  slug                  String
  description           String?
  shortDescription      String?
  status                ProductStatus            @default(DRAFT)
  productType           String?
  tags                  String[]                 @default([])
  seoTitle              String?
  seoDescription        String?
  metadata              Json?
  publishedAt           DateTime?
  unpublishedAt         DateTime?
  requiresShipping      Boolean                  @default(true)
  isDigital             Boolean                  @default(false)
  ageRestricted         Boolean                  @default(false)
  store                 Tenant                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand                 Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  taxCategory           TaxCategory?             @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  unitDefinition        UnitDefinition?          @relation(fields: [unitDefinitionId], references: [id], onDelete: SetNull)
  suppliers             ProductSupplier[]
  personalizations      ProductPersonalization[]
  metafields            ProductMetafieldValue[]
  variants              Variant[]
  salesChannels         ProductSalesChannel[]
  images                ProductImage[]
  options               ProductOption[]
  categories            ProductCategory[]
  collections           CollectionProduct[]
  reviews               Review[]
  blogPosts             BlogPostProduct[]
  wishlists             WishlistItem[]
  discountProducts      DiscountProduct[]
  outgoingRelations     ProductRelation[]        @relation("ProductRelationSource")
  incomingRelations     ProductRelation[]        @relation("ProductRelationTarget")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([brandId])
}

enum ProductRelationType {
  RELATED
  COMPLEMENTARY
  UPSELL
  CROSS_SELL
  ACCESSORY
}

model ProductRelation {
  id              String              @id @default(uuid())
  sourceProductId String
  targetProductId String
  type            ProductRelationType @default(RELATED)
  position        Int                 @default(0)
  sourceProduct   Product             @relation("ProductRelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct   Product             @relation("ProductRelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())

  @@unique([sourceProductId, targetProductId, type])
  @@index([sourceProductId, type, position])
  @@index([targetProductId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductImage {
  id           String         @id @default(uuid())
  productId    String
  url          String
  alt          String?
  sortOrder    Int            @default(0)
  aiGenerated  Boolean        @default(false)
  mediaAssetId String?
  mediaAsset   MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
