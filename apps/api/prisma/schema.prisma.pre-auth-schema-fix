generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountScope {
  ORDER
  PRODUCT
  CATEGORY
}

enum IntegrationType {
  MARKETPLACE
  PAYMENT
  SHIPPING
  INVOICE
  MARKETING
  AI
  SOCIAL
  ANALYTICS
  MESSAGING
  CRM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum QuestionType {
  PRODUCT
  ORDER
}

enum QuestionStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  SPAM
}

enum GeoLevel {
  COUNTRY
  ADMIN1
  ADMIN2
  LOCALITY
  NEIGHBORHOOD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum PromotionActivation {
  AUTOMATIC
  COUPON
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MarketingChannel {
  EMAIL
  SMS
  POPUP
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum AutomationTrigger {
  CART_ABANDONED
  CUSTOMER_CREATED
  ORDER_CREATED
  ORDER_PAID
  CUSTOMER_BIRTHDAY
  MANUAL
}

enum ConsentType {
  TERMS
  PRIVACY
  KVKK_NOTICE
  KVKK_EXPLICIT_CONSENT
  MARKETING_EMAIL
  MARKETING_SMS
  MARKETING_PHONE
  COOKIES_NECESSARY
  COOKIES_ANALYTICS
  COOKIES_MARKETING
}

enum PrivacyRequestType {
  ACCESS
  DELETE
  RECTIFY
  PORTABILITY
  RESTRICT
  OBJECT
}

enum PrivacyRequestStatus {
  RECEIVED
  VERIFYING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  KVKK_NOTICE
  COOKIE_POLICY
  DISTANCE_SALES
  RETURNS
  SHIPPING
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  name           String?
  isSuperAdmin   Boolean      @default(false) // legacy migration-only; runtime auth does not read this
  memberships    Membership[]
  ticketMessages SupportMessage[]
  sessions       UserSession[] // legacy, no longer used by admin auth
  merchantSessions MerchantSession[]
  auditLogs      AuditLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Tenant {
  id           String                  @id @default(uuid())
  name         String
  slug         String                  @unique
  status       TenantStatus            @default(TRIAL)
  trialEndsAt  DateTime?
  memberships  Membership[]
  integrations IntegrationConnection[]
  webhooks     WebhookEndpoint[]
  subscriptions Subscription[]
  tickets      SupportTicket[]
  roles        CustomRole[]
  auditLogs    AuditLog[]
  aiWallet     AiCreditWallet?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  publicSlug         String      @unique
  domain             String?     @unique
  currency           String      @default("TRY")
  locale             String      @default("tr-TR")
  timezone           String      @default("Europe/Istanbul")
  defaultCountry     String      @default("TR")
  weightUnit         String      @default("kg")
  dimensionUnit      String      @default("cm")
  activeTheme        String      @default("default")
  logoUrl            String?
  faviconUrl         String?
  email              String?
  phone              String?
  companyName        String?
  taxNumber          String?
  taxOffice          String?
  addressText        String?
  seoTitle           String?
  seoDescription     String?
  maintenanceMode    Boolean     @default(false)
  nextOrderNumber     Int         @default(1001)
  settings           Json?
  products           Product[]
  categories         Category[]
  brands             Brand[]
  customers          Customer[]
  orders             Order[]
  carts              Cart[]
  discounts          Discount[]
  shippingMethods    ShippingMethod[]
  paymentMethods     PaymentMethod[]
  pages              Page[]
  menus              Menu[]
  banners            Banner[]
  reviews            Review[]
  warehouses         Warehouse[]
  questions          Question[]
  wishlists          WishlistItem[]
  returns            ReturnRequest[]
  addresses          StoreAddress[]
  currencies         StoreCurrency[]
  locales            StoreLocale[]
  translations       ContentTranslation[]
  mediaAssets        MediaAsset[]
  promotions         Promotion[]
  promotionCodes     PromotionCode[]
  loyaltyProgram     LoyaltyProgram?
  loyaltyAccounts    LoyaltyAccount[]
  marketingCampaigns MarketingCampaign[]
  marketingAutomations MarketingAutomation[]
  legalDocuments     LegalDocument[]
  consentRecords     ConsentRecord[]
  privacyRequests    PrivacyRequest[]
  cookiePreferences  CookiePreference[]
  seoRules           SeoRule[]
  seoRedirects       SeoRedirect[]
  seoTranslations    SeoTranslation[]
  seoInternalLinks   SeoInternalLink[]
  seoAudits          SeoAudit[]
  siteSections       SiteSection[]
  cacheConfig        CacheConfig?
  checkoutConfig     CheckoutConfig?
}

model Membership {
  id       String         @id @default(uuid())
  userId   String
  tenantId String
  role     MembershipRole @default(STAFF)
  customRoleId String?
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([userId, tenantId])
}


model Brand {
  id          String    @id @default(uuid())
  storeId     String
  name        String
  slug        String
  logoUrl     String?
  description String?
  seoTitle    String?
  seoDescription String?
  store       Tenant     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([storeId, slug])
}

model Category {
  id          String             @id @default(uuid())
  storeId     String
  parentId    String?
  name        String
  slug        String
  description String?
  imageUrl    String?
  seoTitle    String?
  seoDescription String?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  store       Tenant              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent      Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]         @relation("CategoryTree")
  products    ProductCategory[]
  discountCategories DiscountCategory[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@unique([storeId, slug])
  @@index([storeId, parentId])
}

model Product {
  id             String            @id @default(uuid())
  storeId        String
  brandId        String?
  title          String
  slug           String
  description    String?
  shortDescription String?
  status         ProductStatus     @default(DRAFT)
  productType    String?
  tags           String[]            @default([])
  seoTitle       String?
  seoDescription String?
  metadata       Json?
  store          Tenant             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand          Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants       Variant[]
  images         ProductImage[]
  categories     ProductCategory[]
  reviews        Review[]
  wishlists      WishlistItem[]
  discountProducts DiscountProduct[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([brandId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  mediaAssetId String?
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variant {
  id           String          @id @default(uuid())
  productId    String
  title        String
  sku          String
  barcode      String?
  price        Decimal         @db.Decimal(12, 2)
  comparePrice Decimal?        @db.Decimal(12, 2)
  cost         Decimal?        @db.Decimal(12, 2)
  weight       Decimal?        @db.Decimal(10, 3)
  attributes   Json?
  isActive     Boolean         @default(true)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    InventoryItem?
  warehouseStocks WarehouseStock[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  returnItems  ReturnItem[]
  @@unique([productId, sku])
  @@index([sku])
}

model InventoryItem {
  id           String   @id @default(uuid())
  variantId    String   @unique
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  lowStockAt   Int      @default(5)
  trackStock   Boolean  @default(true)
  allowBackorder Boolean @default(false)
  variant      Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
}

model Customer {
  id              String    @id @default(uuid())
  storeId         String
  email           String
  passwordHash    String?
  firstName       String?
  lastName        String?
  phone           String?
  acceptsMarketing Boolean   @default(false)
  isActive        Boolean    @default(true)
  tags            String[]    @default([])
  metadata        Json?
  store           Tenant     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses       CustomerAddress[]
  orders          Order[]
  reviews         Review[]
  wishlists       WishlistItem[]
  returns         ReturnRequest[]
  loyaltyAccount  LoyaltyAccount?
  consentRecords  ConsentRecord[]
  privacyRequests PrivacyRequest[]
  sessions        CustomerSession[]
  promotionRedemptions PromotionRedemption[]
  carts           Cart[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@unique([storeId, email])
  @@index([storeId, createdAt])
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  title      String?  
  firstName  String
  lastName   String
  phone      String?
  company    String?
  address1   String
  address2   String?
  district   String?
  city       String
  state      String?
  postalCode String?
  country    String   @default("TR")
  admin1Id   String?
  admin2Id   String?
  localityId String?
  neighborhoodId String?
  isDefault  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cart {
  id             String      @id @default(uuid())
  storeId        String
  token          String      @unique
  status         String      @default("active")
  customerId     String?
  customerEmail  String?
  discountCode   String?
  couponCodes    String[]    @default([])
  promotionSnapshot Json?
  currency       String?
  lastActivityAt DateTime    @default(now())
  abandonedAt    DateTime?
  recoveredAt    DateTime?
  note           String?
  shippingMethodId String?
  billingAddress Json?
  shippingAddress Json?
  store          Tenant       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          CartItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  @@index([storeId, status])
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int     @default(1)
  isGift    Boolean @default(false)
  promotionId String?
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   Variant @relation(fields: [variantId], references: [id])
  @@unique([cartId, variantId])
}

model Discount {
  id             String        @id @default(uuid())
  storeId        String
  name           String
  code           String?
  type           DiscountType
  scope          DiscountScope @default(ORDER)
  value          Decimal       @default(0) @db.Decimal(12, 2)
  minimumAmount  Decimal?      @db.Decimal(12, 2)
  maximumDiscount Decimal?     @db.Decimal(12, 2)
  usageLimit     Int?
  usageCount     Int           @default(0)
  perCustomerLimit Int?
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean       @default(true)
  store          Tenant         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products       DiscountProduct[]
  categories     DiscountCategory[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@unique([storeId, code])
  @@index([storeId, isActive])
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([discountId, productId])
}

model DiscountCategory {
  discountId String
  categoryId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([discountId, categoryId])
}

model ShippingMethod {
  id               String   @id @default(uuid())
  storeId          String
  name             String
  code             String
  type             String   @default("shipping") // shipping | courier | pickup | digital | appointment
  description      String?
  requiresAddress  Boolean  @default(true)
  supportsPickup   Boolean  @default(false)
  price            Decimal  @default(0) @db.Decimal(12, 2)
  freeAbove        Decimal? @db.Decimal(12, 2)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  store            Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@unique([storeId, code])
}

model PaymentMethod {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  code        String
  type        String   @default("manual")
  instructions String?
  requiresOnlinePayment Boolean @default(false)
  supportsInstallment Boolean @default(false)
  fee         Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  config      Json?
  store       Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@unique([storeId, code])
}

model Order {
  id               String            @id @default(uuid())
  storeId          String
  customerId       String?
  number           Int
  status           OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  paymentMethod    String?
  shippingMethod   String?
  currency         String            @default("TRY")
  subtotal         Decimal           @db.Decimal(12, 2)
  discountTotal    Decimal           @default(0) @db.Decimal(12, 2)
  shippingTotal    Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal       Decimal           @db.Decimal(12, 2)
  discountCode     String?
  promotionSnapshot Json?
  customerNote     String?
  adminNote        String?
  shippingAddress  Json?
  billingAddress   Json?
  source           String            @default("storefront")
  externalId       String?
  metadata         Json?
  store            Tenant             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer         Customer?          @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  returns          ReturnRequest[]
  promotionRedemptions PromotionRedemption[]
  loyaltyTransactions LoyaltyTransaction[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  variantId String?
  sku       String
  title     String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   Variant? @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  note      String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id          String       @id @default(uuid())
  storeId     String
  orderId     String
  customerId  String?
  status      ReturnStatus @default(REQUESTED)
  reason      String?
  note        String?
  refundAmount Decimal?    @db.Decimal(12, 2)
  store       Tenant        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id])
  items       ReturnItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([storeId, status])
}

model ReturnItem {
  id        String        @id @default(uuid())
  returnId  String
  orderItemId String
  variantId String?
  quantity  Int
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])
  variant   Variant?      @relation(fields: [variantId], references: [id])
}

model Review {
  id         String       @id @default(uuid())
  storeId    String
  productId  String
  customerId String?
  rating     Int
  title      String?
  body       String?
  authorName String?
  authorEmail String?
  status     ReviewStatus @default(PENDING)
  verifiedPurchase Boolean @default(false)
  media      Json?
  merchantReply String?
  repliedAt  DateTime?
  spamScore  Decimal?     @db.Decimal(5,2)
  reportCount Int         @default(0)
  metadata   Json?
  store      Tenant        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  @@index([storeId, status, createdAt])
  @@index([productId, status])
}

model WishlistItem {
  id         String   @id @default(uuid())
  storeId    String
  customerId String
  productId  String
  store      Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([customerId, productId])
}

model Page {
  id             String     @id @default(uuid())
  storeId        String
  title          String
  slug           String
  body           String
  status         PageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  store          Tenant      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  @@unique([storeId, slug])
}

model Menu {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  handle    String
  items     Json
  store     Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([storeId, handle])
}

model Banner {
  id        String   @id @default(uuid())
  storeId   String
  title     String?
  subtitle  String?
  imageUrl  String?
  mobileImageUrl String?
  buttonText String?
  buttonUrl String?
  position  String   @default("home_hero")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  store     Tenant    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([storeId, position, isActive])
}

model Plan {
  id          String         @id @default(uuid())
  name        String
  code        String         @unique
  description String?
  monthlyPrice Decimal       @default(0) @db.Decimal(12, 2)
  yearlyPrice Decimal?       @db.Decimal(12, 2)
  currency    String         @default("TRY")
  trialDays   Int            @default(14)
  maxStaff    Int            @default(3)
  maxProducts Int            @default(1000)
  maxOrdersPerMonth Int? 
  features    Json?
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  subscriptions Subscription[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Subscription {
  id          String             @id @default(uuid())
  tenantId    String
  planId      String
  status      SubscriptionStatus @default(TRIAL)
  startsAt    DateTime           @default(now())
  trialEndsAt DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean      @default(false)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan               @relation(fields: [planId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@index([tenantId, status])
}

model SupportTicket {
  id          String         @id @default(uuid())
  tenantId    String
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  category    String?
  createdById String
  assignedTo  String?
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([tenantId, status])
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String?
  superAdminId String?
  authorType String        @default("merchant")
  body      String
  isInternal Boolean       @default(false)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  superAdmin SuperAdmin?  @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  @@index([superAdminId, createdAt])
}

model IntegrationConnection {
  id          String          @id @default(uuid())
  tenantId    String
  type        IntegrationType
  provider    String
  name        String
  credentials Json
  config      Json?
  enabled     Boolean         @default(true)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([tenantId, type])
}

model WebhookEndpoint {
  id         String            @id @default(uuid())
  tenantId   String
  url        String
  secret     String
  events     String[]
  enabled    Boolean           @default(true)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
